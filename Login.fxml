<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.cab302_teamproject.LoginController" prefWidth="420" prefHeight="520">
    <center>
        <VBox spacing="16" alignment="CENTER" BorderPane.alignment="CENTER" styleClass="card">
            <Label text="Welcome back"/>
            <Label text="Sign in to continue"/>

            <VBox spacing="8" maxWidth="320">
                <Label text="Email"/>
                <TextField promptText="you@example.com"/>
            </VBox>

            <VBox spacing="6" maxWidth="320">
                <Label text="Password"/>
                <PasswordField promptText="••••••••"/>
            </VBox>

            <Button text="Sign In" onAction="#handleLogin"
                    maxWidth="320" prefWidth="320"/>

            <HBox alignment="CENTER" spacing="6">
                <Label text="Don't have an account?"/>
                <Hyperlink text="Sign up" onAction="#goToSignup" focusTraversable="false"/>
            </HBox>
        </VBox>
    </center>
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
</BorderPane>

