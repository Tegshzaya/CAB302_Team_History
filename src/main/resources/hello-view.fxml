<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>

<VBox alignment="CENTER" spacing="24.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.cab302_javafx.HelloController" stylesheets="@style.css">
    <padding>
        <Insets bottom="32.0" left="32.0" right="32.0" top="32.0"/>
    </padding>

    <Label text="Historical Art Guesser" styleClass="title"/>
    <Label text="Test your knowledge of historical art and artifacts" styleClass="subtitle"/>
    
    <VBox spacing="16" alignment="CENTER">
        <Label fx:id="welcomeText" styleClass="welcome-text"/>
        <Button text="Hello!" onAction="#onHelloButtonClick" styleClass="game-button"/>
        <Button text="Historical Image Game" onAction="#onGameButtonClick" styleClass="game-button"/>
    </VBox>
</VBox>
