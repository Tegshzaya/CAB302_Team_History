<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.example.cab302_javafx.LoginController"
      spacing="20" 
      alignment="CENTER" 
      prefWidth="400" 
      prefHeight="500">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    
    <Label text="DEBUG: FXML IS LOADING" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: red;"/>
    
    <TextField fx:id="emailField" promptText="Email" prefWidth="300"/>
    <PasswordField fx:id="passwordField" promptText="Password" prefWidth="300"/>
    
    <Label text="DEBUG: BUTTON SHOULD BE BELOW THIS TEXT" style="-fx-font-size: 16px; -fx-text-fill: blue;"/>
    
    <Button text="🔥 GIANT RED BUTTON 🔥" 
            onAction="#handleLogin" 
            prefWidth="350" 
            prefHeight="60"
            style="-fx-background-color: red; -fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
    
    <Label text="DEBUG: BUTTON SHOULD BE ABOVE THIS TEXT" style="-fx-font-size: 16px; -fx-text-fill: green;"/>
    
</VBox>