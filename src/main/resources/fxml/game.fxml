<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Rectangle2D?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.learn.plan_b_302.GameController">
    <center>
        <StackPane>
            <children>
                <!-- MENU PANE -->
                <VBox fx:id="menuPane" alignment="CENTER" spacing="30.0" styleClass="menu-container">
                    <children>
                        <VBox alignment="CENTER" spacing="10.0">
                            <children>
                                <Label fx:id="welcomeLabel" styleClass="welcome-title" text="Welcome, Player!">
                                    <font>
                                        <Font size="28.0" />
                                    </font>
                                </Label>
                                <Label styleClass="subtitle" text="🎨 Art Guesser Game">
                                    <font>
                                        <Font size="20.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>

                        <VBox alignment="CENTER" spacing="15.0" styleClass="stats-container">
                            <children>
                                <Label fx:id="bestScoreLabel" styleClass="stats-label" text="Best Score: 0">
                                    <font>
                                        <Font size="16.0" />
                                    </font>
                                </Label>
                                <Label fx:id="gamesPlayedLabel" styleClass="stats-label" text="Games Played: 0">
                                    <font>
                                        <Font size="16.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>

                        <VBox alignment="CENTER" maxWidth="300.0" spacing="15.0">
                            <children>
                                <Button onAction="#handleStartGame" prefWidth="200.0" styleClass="primary-button" text="🎮 Start Game">
                                    <font>
                                        <Font size="18.0" />
                                    </font>
                                </Button>
                                <Button onAction="#handleLocationGame" prefWidth="200.0" styleClass="primary-button" text="📍Location Game">
                                    <font>
                                        <Font size="18.0" />
                                    </font>
                                </Button>
                                <Button onAction="#handleViewScores" prefWidth="200.0" styleClass="secondary-button" text="📊 View Statistics">
                                    <font>
                                        <Font size="16.0" />
                                    </font>
                                </Button>
                                <Button fx:id="logoutButton" onAction="#handleLogout" prefWidth="200.0" styleClass="logout-button" text="🚪 Logout">
                                    <font>
                                        <Font size="16.0" />
                                    </font>
                                </Button>
                            </children>
                        </VBox>
                    </children>
                    <padding>
                        <Insets bottom="50.0" left="50.0" right="50.0" top="50.0" />
                    </padding>
                </VBox>

                <!-- GAME PANE -->
                <VBox fx:id="gamePane" spacing="20.0" styleClass="game-container" visible="false">
                    <children>
                        <!-- Game Header -->
                        <HBox alignment="CENTER" spacing="50.0" styleClass="game-header">
                            <children>
                                <Label fx:id="questionCountLabel" styleClass="game-info" text="Question 1 of 10">
                                    <font>
                                        <Font size="18.0" />
                                    </font>
                                </Label>
                                <Label fx:id="scoreLabel" styleClass="score-label" text="Score: 0">
                                    <font>
                                        <Font size="18.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>

                        <!-- Art Image Display -->
                        <VBox alignment="CENTER" spacing="10.0">
                            <children>
                                <Label styleClass="question-label" text="Who is the artist of this artwork?">
                                    <font>
                                        <Font size="20.0" />
                                    </font>
                                </Label>
                                <ImageView fx:id="artImageView" fitHeight="300.0" fitWidth="400.0" pickOnBounds="true" preserveRatio="true" styleClass="art-image">
                                    <viewport>
                                        <Rectangle2D />
                                    </viewport>
                                </ImageView>
                            </children>
                        </VBox>

                        <!-- Answer Options -->
                        <VBox alignment="CENTER" spacing="15.0" styleClass="options-container">
                            <children>
                                <HBox alignment="CENTER" spacing="20.0">
                                    <children>
                                        <Button fx:id="option1Button" onAction="#handleOption1" prefWidth="180.0" styleClass="option-button" text="Option 1">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Button>
                                        <Button fx:id="option2Button" onAction="#handleOption2" prefWidth="180.0" styleClass="option-button" text="Option 2">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Button>
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER" spacing="20.0">
                                    <children>
                                        <Button fx:id="option3Button" onAction="#handleOption3" prefWidth="180.0" styleClass="option-button" text="Option 3">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Button>
                                        <Button fx:id="option4Button" onAction="#handleOption4" prefWidth="180.0" styleClass="option-button" text="Option 4">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Button>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Feedback Section -->
                        <VBox alignment="CENTER" spacing="15.0">
                            <children>
                                <Label fx:id="feedbackLabel" styleClass="feedback-label" wrapText="true">
                                    <font>
                                        <Font size="16.0" />
                                    </font>
                                </Label>
                                <Button fx:id="nextQuestionButton" onAction="#handleNextQuestion" styleClass="next-button" text="Next Question ➤" visible="false">
                                    <font>
                                        <Font size="16.0" />
                                    </font>
                                </Button>
                            </children>
                        </VBox>
                    </children>
                    <padding>
                        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                    </padding>
                </VBox>

                <!-- END GAME PANE -->
                <VBox fx:id="endGamePane" alignment="CENTER" spacing="30.0" styleClass="end-game-container" visible="false">
                    <children>
                        <VBox alignment="CENTER" spacing="15.0">
                            <children>
                                <Label styleClass="end-game-title" text="🎯 Game Complete!">
                                    <font>
                                        <Font size="32.0" />
                                    </font>
                                </Label>
                                <Label fx:id="newBestScoreLabel" styleClass="new-best-score" text="🎉 New Best Score! 🎉" visible="false">
                                    <font>
                                        <Font size="18.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>

                        <VBox alignment="CENTER" spacing="10.0" styleClass="final-stats">
                            <children>
                                <Label fx:id="finalScoreLabel" styleClass="final-score" text="Final Score: 0 / 10">
                                    <font>
                                        <Font size="24.0" />
                                    </font>
                                </Label>
                                <Label fx:id="finalPercentageLabel" styleClass="final-percentage" text="Percentage: 0.0%">
                                    <font>
                                        <Font size="20.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>

                        <VBox alignment="CENTER" maxWidth="300.0" spacing="15.0">
                            <children>
                                <Button fx:id="playAgainButton" onAction="#handlePlayAgain" prefWidth="200.0" styleClass="primary-button" text="🎮 Play Again">
                                    <font>
                                        <Font size="16.0" />
                                    </font>
                                </Button>
                                <Button fx:id="returnToMenuButton" onAction="#handleReturnToMenu" prefWidth="200.0" styleClass="secondary-button" text="📋 Return to Menu">
                                    <font>
                                        <Font size="16.0" />
                                    </font>
                                </Button>
                                <Button onAction="#handleLogoutFromEnd" prefWidth="200.0" styleClass="logout-button" text="🚪 Logout">
                                    <font>
                                        <Font size="16.0" />
                                    </font>
                                </Button>
                            </children>
                        </VBox>
                    </children>
                    <padding>
                        <Insets bottom="50.0" left="50.0" right="50.0" top="50.0" />
                    </padding>
                </VBox>
            </children>
        </StackPane>
    </center>
</BorderPane>