<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.learn.plan_b_302.LocationController"
            styleClass="auth-container main-layout" stylesheets="@../css/modern-style.css">

    <top>
        <HBox spacing="16" styleClass="game-header" alignment="CENTER">
            <padding><Insets topRightBottomLeft="16"/></padding>
            <Label text="🌍 Guess the Location" styleClass="heading-3"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label fx:id="roundLabel" text="Round 1 / 1" styleClass="game-info"/>
            <Label fx:id="scoreLabel" text="Score: 0" styleClass="score-label"/>
        </HBox>
    </top>

    <center>
        <StackPane>
            <!-- GAME PANE -->
            <SplitPane fx:id="gamePane" dividerPositions="0.4" visible="true">
                <items>
                    <VBox spacing="16" styleClass="modern-card" alignment="CENTER">
                        <padding><Insets topRightBottomLeft="16"/></padding>
                        <ImageView fx:id="photoView" preserveRatio="true" fitWidth="320" fitHeight="240" styleClass="art-image"/>
                        <Label text="Drop a pin on the map where you think this photo was taken." 
                               styleClass="body-small" wrapText="true" textAlignment="CENTER" maxWidth="300"/>
                        <VBox spacing="12" alignment="CENTER" styleClass="button-container">
                            <VBox spacing="12" alignment="CENTER" styleClass="button-container">
                                <Button text="Submit" onAction="#onSubmit" fx:id="submitBtn" styleClass="btn-primary" prefWidth="280" minHeight="48"/>
                                <Button text="Next" onAction="#onNext" fx:id="nextBtn" disable="true" styleClass="btn-secondary" prefWidth="280" minHeight="48"/>
                            </VBox>
                            <Button text="← Back" onAction="#onBackToMenu" styleClass="btn-ghost" prefWidth="320" minHeight="48"/>
                        </VBox>
                        <Label fx:id="feedbackLabel" wrapText="true" styleClass="feedback-label" maxWidth="300"/>
                    </VBox>

                    <VBox fillWidth="true" VBox.vgrow="ALWAYS" minWidth="0" minHeight="0">
                        <padding><Insets topRightBottomLeft="8"/></padding>
                        <WebView fx:id="mapView"
                                 prefWidth="400" prefHeight="400"
                                 minWidth="0" minHeight="0"
                                 VBox.vgrow="ALWAYS"/>
                    </VBox>
                </items>
            </SplitPane>
            
            <!-- END GAME PANE -->
            <VBox fx:id="endGamePane" alignment="CENTER" spacing="24" styleClass="end-game-container" visible="false">
                <children>
                    <!-- Celebration Header -->
                    <VBox alignment="CENTER" spacing="12">
                        <children>
                            <Label styleClass="heading-2" text="🌍 Geography Challenge Complete!" />
                            <Label text="You've explored amazing locations around the world" styleClass="body" textAlignment="CENTER" />
                        </children>
                    </VBox>

                    <!-- Enhanced Stats Display -->
                    <VBox alignment="CENTER" spacing="12" styleClass="final-stats">
                        <children>
                            <Label text="📈 Your Results" styleClass="body" />
                            <Label fx:id="finalScoreLabel" styleClass="heading-3" text="Final Score: 0 / 30" />
                            <Label fx:id="finalAccuracyLabel" styleClass="body" text="Average Distance: 0 km" />
                        </children>
                    </VBox>

                    <!-- Action Buttons -->
                    <VBox alignment="CENTER" maxWidth="380" spacing="12">
                        <children>
                            <Button fx:id="checkAndLearnButton" onAction="#handleCheckAndLearn" prefWidth="280" 
                                    styleClass="btn-primary" text="🗺️ Check and Learn" minHeight="48" />
                            <Button fx:id="playAgainButton" onAction="#handlePlayAgain" prefWidth="280" 
                                    styleClass="btn-secondary" text="🌍 Play Again" minHeight="48" />
                            <Button onAction="#onBackToMenu" prefWidth="320" 
                                    styleClass="btn-ghost" text="🏠 Back to Menu" minHeight="48" />
                        </children>
                    </VBox>
                </children>
                <padding>
                    <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                </padding>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
