<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.learn.plan_b_302.AuthController"
           styleClass="auth-container main-layout" stylesheets="@../css/modern-style.css">

    <!-- Main Content Container -->
    <VBox alignment="CENTER" spacing="20" styleClass="centered-content">
        <!-- Enhanced Header Section -->
        <VBox alignment="CENTER" spacing="16" styleClass="padding-lg">
            <Label text="🎨" styleClass="display-2" />
            <VBox alignment="CENTER" spacing="8">
                <Label text="Historical Art Guesser" styleClass="title-label" />
                <Label text="Join the art discovery adventure" styleClass="body" textAlignment="CENTER" />
            </VBox>
        </VBox>

        <!-- Modern Glassmorphism Signup Form -->
        <VBox alignment="CENTER" spacing="24" styleClass="glass-card-elevated form-container">
            <!-- Welcome Header -->
            <VBox alignment="CENTER" spacing="16">
                <Label text="Create Account" styleClass="subtitle-label" />
                <Label text="Start your journey into art history" styleClass="body" textAlignment="CENTER" />
            </VBox>

            <!-- Enhanced Input Fields -->
            <VBox spacing="20" styleClass="spacing-md">
                <VBox spacing="8" alignment="CENTER">
                    <Label text="Username" styleClass="field-label" />
                    <TextField fx:id="usernameField" promptText="👤 Create your username (min 3 characters)" 
                               styleClass="input-field" prefWidth="350" />
                </VBox>

                <VBox spacing="8" alignment="CENTER">
                    <Label text="Password" styleClass="field-label" />
                    <PasswordField fx:id="passwordField" promptText="🔒 Create secure password (min 6 characters)" 
                                   styleClass="input-field" prefWidth="350" />
                </VBox>
            </VBox>

            <!-- Message Label -->
            <Label fx:id="messageLabel" styleClass="message-label" />

            <!-- Enhanced Button Section -->
            <VBox spacing="16" alignment="CENTER" styleClass="button-container">
                <Button fx:id="signupButton" onAction="#handleSignup" text="🚀 Create Account" 
                        styleClass="btn-primary" prefWidth="350" />
                
                <HBox alignment="CENTER" spacing="16">
                    <Label text="Already have an account?" styleClass="body" />
                    <Button fx:id="switchToLoginButton" onAction="#switchToLogin" text="Sign In"
                            styleClass="btn-ghost" />
                </HBox>
            </VBox>

            <!-- Enhanced Terms Info -->
            <VBox spacing="16" alignment="CENTER" styleClass="glass-card-subtle padding-md">
                <Label text="📋 Terms &amp; Privacy" styleClass="caption" />
                <Label text="By creating an account, you agree to explore art history responsibly" 
                       styleClass="body-small" textAlignment="CENTER" wrapText="true" maxWidth="320" />
            </VBox>
        </VBox>
    </VBox>
</StackPane>