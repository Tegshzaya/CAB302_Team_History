<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.learn.plan_b_302.MenuController"
           styleClass="auth-container main-layout" stylesheets="@../css/modern-style.css">

    <!-- Main Content Container -->
    <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="scroll-container">
        <VBox alignment="CENTER" spacing="20" styleClass="centered-content">
            <padding><Insets top="20" bottom="20" left="20" right="20"/></padding>
            
            <!-- Player Profile Header -->
            <HBox spacing="24" alignment="CENTER" styleClass="profile-header">
                <!-- Profile Card -->
                <VBox spacing="12" styleClass="glass-card profile-card" alignment="CENTER" minWidth="280" maxWidth="320">
                    <padding><Insets topRightBottomLeft="16"/></padding>
                    <Label text="👤" styleClass="display-4" />
                    <VBox alignment="CENTER" spacing="4">
                        <Label fx:id="welcomeLabel" text="Welcome, Player!" styleClass="heading-4" />
                        <Label text="Art History Explorer" styleClass="caption" />
                    </VBox>
                    <HBox spacing="8" alignment="CENTER">
                        <Button text="📈 History" onAction="#handleViewHistory" styleClass="btn-secondary btn-small" minWidth="80" />
                        <Button text="🚪 Sign Out" onAction="#handleSignOut" styleClass="btn-ghost btn-small" minWidth="80" />
                    </HBox>
                </VBox>
            
                <!-- Stats Cards -->
                <HBox spacing="16" alignment="CENTER">
                    <!-- Year Game Stats -->
                    <VBox spacing="8" styleClass="glass-card stat-card" alignment="CENTER" minWidth="160" maxWidth="180">
                        <padding><Insets topRightBottomLeft="12"/></padding>
                        <Label text="📅" styleClass="heading-1" />
                        <VBox alignment="CENTER" spacing="4">
                            <Label text="Year Game" styleClass="body-small" />
                            <Label fx:id="yearBestScoreLabel" text="Best: 0/10" styleClass="body" />
                            <Label fx:id="yearGamesPlayedLabel" text="Played: 0" styleClass="caption" />
                        </VBox>
                    </VBox>
                    
                    <!-- Location Game Stats -->
                    <VBox spacing="8" styleClass="glass-card stat-card" alignment="CENTER" minWidth="160" maxWidth="180">
                        <padding><Insets topRightBottomLeft="12"/></padding>
                        <Label text="🌍" styleClass="heading-1" />
                        <VBox alignment="CENTER" spacing="4">
                            <Label text="Location Game" styleClass="body-small" />
                            <Label fx:id="locationBestScoreLabel" text="Best: 0/30" styleClass="body" />
                            <Label fx:id="locationGamesPlayedLabel" text="Played: 0" styleClass="caption" />
                        </VBox>
                    </VBox>
                </HBox>
        </HBox>
            
            <!-- App Title Section -->
            <VBox alignment="CENTER" spacing="12" styleClass="app-header">
                <Label text="🎨" styleClass="display-3" />
                <VBox alignment="CENTER" spacing="4">
                    <Label text="Historical Art Guesser" styleClass="heading-2" />
                    <Label text="Choose your adventure in art history" styleClass="body" textAlignment="CENTER" />
                </VBox>
            </VBox>

            <!-- Modern Game Selection Cards -->
            <HBox spacing="32" alignment="CENTER" styleClass="button-row">
                <!-- Enhanced Location Game Card -->
                <VBox spacing="20" styleClass="glass-card-elevated interactive" alignment="CENTER" 
                      minWidth="300" minHeight="280" maxWidth="380" prefWidth="340">
                    <VBox spacing="12" alignment="CENTER">
                        <Label text="🌍" styleClass="display-4" />
                        <Label text="Guess the Location" styleClass="heading-3" />
                        <Label text="Embark on a geographical journey through art history. Test your knowledge by identifying where famous artworks originated." 
                               styleClass="body-small" textAlignment="CENTER" wrapText="true" maxWidth="280" />
                    </VBox>
                    
                    <VBox spacing="12" alignment="CENTER" styleClass="button-container">
                        <Button text="✨ Start Adventure" onAction="#handleLocationGame" 
                                styleClass="btn-primary btn-medium" minWidth="200" minHeight="40" />
                        <VBox alignment="CENTER" spacing="4">
                            <Label text="📍 Interactive Map Experience" styleClass="caption" />
                            <Label text="Explore • Discover • Learn" styleClass="body-small" />
                        </VBox>
                    </VBox>
                </VBox>

                <!-- Enhanced Year Game Card -->
                <VBox spacing="20" styleClass="glass-card-elevated interactive" alignment="CENTER" 
                      minWidth="300" minHeight="280" maxWidth="380" prefWidth="340">
                    <VBox spacing="12" alignment="CENTER">
                        <Label text="📅" styleClass="display-4" />
                        <Label text="Guess the Year" styleClass="heading-3" />
                        <Label text="Travel through time with masterpieces from across the centuries. Challenge yourself to guess when these works were created." 
                               styleClass="body-small" textAlignment="CENTER" wrapText="true" maxWidth="280" />
                    </VBox>
                    
                    <VBox spacing="12" alignment="CENTER" styleClass="button-container">
                        <Button text="🕰️ Begin Journey" onAction="#handleYearGame" 
                                styleClass="btn-secondary btn-medium" minWidth="200" minHeight="40" />
                        <VBox alignment="CENTER" spacing="4">
                            <Label text="🎨 Artistic Timeline Quest" styleClass="caption" />
                            <Label text="Renaissance • Baroque • Modern" styleClass="body-small" />
                        </VBox>
                    </VBox>
                </VBox>
            </HBox>

            <!-- Recent Games Section -->
            <VBox spacing="12" alignment="CENTER" styleClass="recent-games-section" maxWidth="600">
                <Label text="📈 Recent Games" styleClass="body" />
                <VBox fx:id="recentGamesContainer" spacing="6" styleClass="recent-games-list" maxWidth="600">
                    <Label text="No games played yet. Start playing to see your recent games here!" styleClass="body-small" />
                </VBox>
            </VBox>
            
            <!-- Enhanced Footer -->
            <VBox spacing="8" alignment="CENTER" styleClass="button-container">
                <VBox alignment="CENTER" spacing="4">
                    <Label text="Ready to explore the fascinating world of art history?" styleClass="body-small" textAlignment="CENTER" />
                    <Label text="Each game offers unique challenges and discoveries" styleClass="caption" textAlignment="CENTER" />
                </VBox>
            </VBox>
        </VBox>
    </ScrollPane>
</StackPane>
