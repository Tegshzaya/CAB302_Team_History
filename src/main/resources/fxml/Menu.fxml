<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.learn.plan_b_302.MenuController"
           styleClass="auth-container" stylesheets="@../css/style.css">

    <VBox alignment="CENTER" spacing="32" styleClass="padding-2xl">
        <!-- Header Section -->
        <VBox alignment="CENTER" spacing="16">
            <Label text="🎨" styleClass="display-1" />
            <Label text="Historical Art Guesser" styleClass="title-label" />
            <Label text="Choose your adventure" styleClass="body" />
        </VBox>

        <!-- Game Selection Cards -->
        <HBox spacing="32" alignment="CENTER">
            <!-- Location Game Card -->
            <VBox spacing="20" styleClass="modern-card-elevated" alignment="CENTER" minWidth="320" minHeight="280">
                <VBox spacing="12" alignment="CENTER">
                    <Label text="🌍" styleClass="display-2" />
                    <Label text="Guess the Location" styleClass="heading-2" />
                    <Label text="Test your geography knowledge by identifying where historical events took place" 
                           styleClass="body" textAlignment="CENTER" wrapText="true" maxWidth="280" />
                </VBox>
                
                <VBox spacing="12" alignment="CENTER">
                    <Button text="Start Game" onAction="#handleLocationGame" 
                            styleClass="btn-primary btn-large" minWidth="200" />
                    <Label text="📍 Interactive map gameplay" styleClass="caption" />
                </VBox>
            </VBox>

            <!-- Year Game Card -->
            <VBox spacing="20" styleClass="modern-card-elevated" alignment="CENTER" minWidth="320" minHeight="280">
                <VBox spacing="12" alignment="CENTER">
                    <Label text="📅" styleClass="display-2" />
                    <Label text="Guess the Year" styleClass="heading-2" />
                    <Label text="Challenge your historical knowledge by guessing when famous artworks were created" 
                           styleClass="body" textAlignment="CENTER" wrapText="true" maxWidth="280" />
                </VBox>
                
                <VBox spacing="12" alignment="CENTER">
                    <Button text="Start Game" onAction="#handleYearGame" 
                            styleClass="btn-primary btn-large" minWidth="200" />
                    <Label text="🎨 Art history focus" styleClass="caption" />
                </VBox>
            </VBox>
        </HBox>

        <!-- Footer -->
        <VBox spacing="16" alignment="CENTER">
            <Button text="Sign Out" onAction="#ReturnLogin" styleClass="btn-ghost" />
            <Label text="Ready to explore history?" styleClass="body-small" />
        </VBox>
    </VBox>
</StackPane>
