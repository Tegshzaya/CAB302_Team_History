<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.learn.plan_b_302.AuthController"
           prefHeight="700.0" prefWidth="1000.0" styleClass="auth-container" stylesheets="@../css/style.css">

    <!-- Background Pattern -->
    <VBox alignment="CENTER" spacing="0">
        <!-- Header Section -->
        <VBox alignment="CENTER" spacing="16" styleClass="padding-2xl">
            <Label text="🎨" styleClass="display-1" />
            <Label text="Historical Art Guesser" styleClass="title-label" />
            <Label text="Discover the stories behind masterpieces" styleClass="body" />
        </VBox>

        <!-- Main Content -->
        <VBox alignment="CENTER" spacing="24" styleClass="auth-form">
            <VBox alignment="CENTER" spacing="8">
                <Label text="Welcome Back" styleClass="subtitle-label" />
                <Label text="Sign in to continue your art journey" styleClass="body-small" />
            </VBox>

            <VBox spacing="16" styleClass="spacing-md">
                <VBox spacing="8">
                    <Label text="Username" styleClass="field-label" />
                    <TextField fx:id="usernameField" promptText="Enter your username" styleClass="input-field" />
                </VBox>

                <VBox spacing="8">
                    <Label text="Password" styleClass="field-label" />
                    <PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="input-field" />
                </VBox>
            </VBox>

            <Label fx:id="messageLabel" styleClass="message-label" />

            <VBox spacing="12" alignment="CENTER">
                <Button fx:id="loginButton" onAction="#handleLogin" text="Sign In" 
                        styleClass="primary-button btn-large" />
                
                <HBox alignment="CENTER" spacing="8">
                    <Label text="Don't have an account?" styleClass="body-small" />
                    <Button fx:id="switchToSignupButton" onAction="#switchToSignup" text="Sign Up"
                            styleClass="secondary-button" />
                </HBox>
            </VBox>

            <!-- Demo Account Info -->
            <VBox spacing="8" alignment="CENTER" styleClass="padding-md">
                <Label text="Demo Account" styleClass="caption" />
                <Label text="Username: demo | Password: demo" styleClass="body-small" />
            </VBox>
        </VBox>
    </VBox>
</StackPane>