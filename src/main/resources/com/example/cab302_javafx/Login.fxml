<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cab302_javafx.LoginController"
            prefWidth="420" prefHeight="520" stylesheets="@style.css">
    <center>
        <VBox spacing="24" alignment="CENTER" styleClass="card fade-in" maxWidth="380">
            <Label text="Welcome Back!" styleClass="title"/>
            <Label text="Sign in to continue your journey." styleClass="subtitle"/>

            <VBox styleClass="form-section">
                <Label text="Email"/>
                <TextField fx:id="emailField" promptText="you@example.com"/>
            </VBox>

            <VBox styleClass="form-section">
                <Label text="Password"/>
                <PasswordField fx:id="passwordField" promptText="••••••••"/>
            </VBox>

            <Button text="Sign In" onAction="#handleLogin" prefWidth="320" styleClass="slide-up"/>

            <HBox alignment="CENTER" spacing="6">
                <Label text="Don't have an account?"/>
                <Hyperlink text="Sign up" onAction="#goToSignup"/>
            </HBox>
        </VBox>
    </center>
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
</BorderPane>