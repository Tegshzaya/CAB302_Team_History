<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.login_page.SelectionScreenController"
           prefHeight="900.0" prefWidth="1200.0" styleClass="login-container main-layout" 
           stylesheets="@styles.css">

    <!-- Main Content Container -->
    <VBox alignment="CENTER" spacing="48" styleClass="centered-content">
        <!-- Header Section -->
        <VBox spacing="20" alignment="CENTER" styleClass="padding-2xl">
            <Label text="Historical Art Guesser" styleClass="title"/>
            <Label text="Choose a Game Mode" styleClass="subtitle"/>
        </VBox>

        <!-- Game Selection Cards -->
        <HBox styleClass="button-row" spacing="48" alignment="CENTER">
            <!-- Card: Guess the Location -->
            <VBox styleClass="card" spacing="20" maxWidth="420" minWidth="400">
                <ImageView fx:id="imgLocation" styleClass="image-view" fitWidth="380" fitHeight="240" preserveRatio="true">
                    <image>
                        <Image url="@guessLocation.jpg" />
                    </image>
                </ImageView>
                <VBox spacing="16" alignment="CENTER">
                    <Label text="Guess the Location" styleClass="h2"/>
                    <Label wrapText="true" styleClass="muted" textAlignment="CENTER"
                           text="Test your geography knowledge! Click on the world map to guess where famous artworks are located."/>
                    <Button text="Play Location Game" onAction="#onChooseLocationGame" 
                            styleClass="game-button" minWidth="200" minHeight="48"/>
                </VBox>
            </VBox>

            <!-- Card: Guess the Year -->
            <VBox styleClass="card" spacing="20" maxWidth="420" minWidth="400">
                <ImageView fx:id="imgYear" styleClass="image-view" fitWidth="380" fitHeight="240" preserveRatio="true">
                    <image>
                        <Image url="@guessYear.jpg" />
                    </image>
                </ImageView>
                <VBox spacing="16" alignment="CENTER">
                    <Label text="Guess the Year" styleClass="h2"/>
                    <Label wrapText="true" styleClass="muted" textAlignment="CENTER"
                           text="Test your knowledge of art history! Guess the year when famous artworks were created."/>
                    <Button text="Play Year Game" onAction="#onChooseYearGame" 
                            styleClass="game-button" minWidth="200" minHeight="48"/>
                </VBox>
            </VBox>
        </HBox>

        <!-- Footer -->
        <VBox spacing="16" alignment="CENTER" styleClass="button-container">
            <Hyperlink text="Sign out" onAction="#onSignOut" styleClass="btn-ghost"/>
        </VBox>
    </VBox>
</StackPane>
