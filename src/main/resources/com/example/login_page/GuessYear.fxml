<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.login_page.GuessYearController" 
      styleClass="game-container vbox" 
      spacing="20" alignment="CENTER">
    <padding>
        <Insets topRightBottomLeft="32"/>
    </padding>

    <Label text="Historical Art Guesser" styleClass="title"/>
    
    <VBox styleClass="image-container vbox" spacing="12" alignment="CENTER">
        <ImageView fx:id="photoView" styleClass="image-view" fitWidth="500" fitHeight="400" preserveRatio="true"/>
    </VBox>

    <HBox styleClass="hbox" spacing="16" alignment="CENTER">
        <Label text="Your guess:" styleClass="h3"/>
        <TextField fx:id="yearField" promptText="e.g., 1801" prefWidth="120" styleClass="text-field"/>
        <Button text="Submit" onAction="#onSubmit" styleClass="button"/>
        <Button fx:id="nextBtn" text="Next" onAction="#onNext" disable="true" styleClass="game-button"/>
        <Button fx:id="skipBtn" text="Skip" onAction="#onSkip" styleClass="btn-warning"/>
    </HBox>

    <Label fx:id="feedbackLabel" styleClass="feedback-label"/>
</VBox>
