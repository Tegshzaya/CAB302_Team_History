<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.login_page.GuessYearController" 
           prefHeight="900.0" prefWidth="1200.0" styleClass="game-container main-layout" 
           stylesheets="@styles.css">

    <!-- Main Content Container -->
    <VBox alignment="CENTER" spacing="40" styleClass="centered-content">
        <!-- Header Section -->
        <VBox spacing="16" alignment="CENTER" styleClass="padding-2xl">
            <Label text="🎨 Guess the Year" styleClass="title"/>
            <Label text="Can you guess when this famous artwork was created?" styleClass="subtitle"/>
        </VBox>

        <!-- Score and Round Info -->
        <HBox styleClass="card" spacing="48" alignment="CENTER" styleClass="button-row">
            <VBox spacing="8" alignment="CENTER">
                <Label text="Round" styleClass="muted"/>
                <Label fx:id="roundLabel" styleClass="h3"/>
            </VBox>
            <VBox spacing="8" alignment="CENTER">
                <Label text="Score" styleClass="muted"/>
                <Label fx:id="scoreLabel" styleClass="h3"/>
            </VBox>
        </HBox>

        <!-- Main Game Area -->
        <HBox styleClass="button-row" spacing="48" alignment="CENTER">
            <!-- Artwork Image Section -->
            <VBox styleClass="image-container" spacing="20" alignment="CENTER" minWidth="400">
                <Label text="🎨 Famous Artwork" styleClass="h2"/>
                <ImageView fx:id="photoView" styleClass="image-view" fitWidth="400" fitHeight="300" preserveRatio="true"/>
                <Label fx:id="artworkInfo" text="Loading artwork..." styleClass="muted"/>
            </VBox>
            
            <!-- Input and Control Section -->
            <VBox styleClass="card" spacing="24" alignment="CENTER" prefWidth="400">
                <Label text="📅 Your Guess" styleClass="h2"/>
                
                <!-- Year Input -->
                <VBox spacing="16" alignment="CENTER" styleClass="button-container">
                    <Label text="Enter the year:" styleClass="h3"/>
                    <TextField fx:id="yearField" promptText="e.g., 1801" prefWidth="200" styleClass="text-field"/>
                    <Button text="Submit Guess" onAction="#onSubmit" styleClass="btn-primary" prefWidth="200" minHeight="48"/>
                </VBox>
                
                <!-- Control Buttons -->
                <VBox spacing="16" alignment="CENTER" styleClass="button-container">
                    <Button fx:id="nextBtn" text="Next Round" onAction="#onNext" disable="true" 
                            styleClass="btn-success" prefWidth="200" minHeight="48"/>
                    <Button fx:id="skipBtn" text="Skip" onAction="#onSkip" 
                            styleClass="btn-warning" prefWidth="200" minHeight="48"/>
                    <Button text="Back to Menu" onAction="#onBackToMenu" 
                            styleClass="btn-ghost" prefWidth="200" minHeight="48"/>
                </VBox>
            </VBox>
        </HBox>

        <!-- Feedback Section -->
        <VBox styleClass="card" spacing="12" alignment="CENTER" maxWidth="800">
            <Label fx:id="feedbackLabel" styleClass="feedback-label" wrapText="true" textAlignment="CENTER"/>
        </VBox>
    </VBox>
</StackPane>
