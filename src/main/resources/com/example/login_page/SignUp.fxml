<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import java.net.URL?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.login_page.SignUpController"
      alignment="CENTER">

    <stylesheets>
        <URL value="@styles.css" />
    </stylesheets>

    <padding><Insets top="32" right="24" bottom="32" left="24"/></padding>

    <VBox spacing="14" maxWidth="400" styleClass="card">
        <Label text="Create your account" styleClass="h1"/>
        <Label text="It only takes a minute." styleClass="muted"/>

        <TextField promptText="Username"/>
        <TextField promptText="Email"/>
        <PasswordField promptText="Password"/>
        <PasswordField promptText="Confirm password"/>

        <Button text="Sign up" styleClass="btn-primary" maxWidth="Infinity"/>

        <HBox alignment="CENTER" spacing="6">
            <Label text="Already have an account?" styleClass="muted"/>
            <Hyperlink text="Back to Login" onAction="#onBackToLogin"/>
        </HBox>
    </VBox>
</VBox>
