<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.login_page.SignUpController" 
      styleClass="login-container" 
      spacing="24" alignment="CENTER">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <!-- Header Section -->
    <VBox spacing="8" alignment="CENTER">
        <Label text="🎨 Historical Art Guesser" styleClass="title"/>
        <Label text="Create your account to start playing" styleClass="subtitle"/>
    </VBox>

    <!-- Registration Form -->
    <VBox styleClass="card" spacing="20" alignment="CENTER" prefWidth="400">
        <Label text="📝 Create Account" styleClass="h2"/>
        
        <!-- Username Field -->
        <VBox spacing="8" alignment="CENTER">
            <Label text="Username:" styleClass="form-label"/>
            <TextField fx:id="usernameField" promptText="Choose a username (min 3 characters)" prefWidth="300" styleClass="text-field"/>
        </VBox>
        
        <!-- Password Field -->
        <VBox spacing="8" alignment="CENTER">
            <Label text="Password:" styleClass="form-label"/>
            <PasswordField fx:id="passwordField" promptText="Create a password (min 6 characters)" prefWidth="300" styleClass="text-field"/>
        </VBox>
        
        <!-- Confirm Password Field -->
        <VBox spacing="8" alignment="CENTER">
            <Label text="Confirm Password:" styleClass="form-label"/>
            <PasswordField fx:id="confirmPasswordField" promptText="Confirm your password" prefWidth="300" styleClass="text-field"/>
        </VBox>
        
        <!-- Sign Up Button -->
        <Button text="Create Account" onAction="#onSubmit" styleClass="btn-primary" prefWidth="300"/>
        
        <!-- Back to Login Link -->
        <HBox spacing="8" alignment="CENTER">
            <Label text="Already have an account?" styleClass="muted"/>
            <Button text="Sign In" onAction="#onBackToLogin" styleClass="btn-link"/>
        </HBox>
    </VBox>

    <!-- Footer -->
    <Label text="Join thousands of players testing their art history knowledge!" styleClass="muted" wrapText="true" maxWidth="400"/>
</VBox>
