<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.login_page.SignUpController" 
           prefHeight="900.0" prefWidth="1200.0" styleClass="login-container main-layout" 
           stylesheets="@styles.css">

    <!-- Main Content Container -->
    <VBox alignment="CENTER" spacing="40" styleClass="centered-content">
        <!-- Header Section -->
        <VBox spacing="16" alignment="CENTER" styleClass="padding-2xl">
            <Label text="🎨 Historical Art Guesser" styleClass="title"/>
            <Label text="Create your account to start playing" styleClass="subtitle"/>
        </VBox>

        <!-- Registration Form Card -->
        <VBox styleClass="card form-layout" spacing="24" alignment="CENTER" prefWidth="450">
            <Label text="📝 Create Account" styleClass="h2"/>
            
            <!-- Username Field -->
            <VBox spacing="12" alignment="CENTER">
                <Label text="Username:" styleClass="form-label"/>
                <TextField fx:id="usernameField" promptText="Choose a username (min 3 characters)" 
                           prefWidth="350" styleClass="text-field"/>
            </VBox>
            
            <!-- Password Field -->
            <VBox spacing="12" alignment="CENTER">
                <Label text="Password:" styleClass="form-label"/>
                <PasswordField fx:id="passwordField" promptText="Create a password (min 6 characters)" 
                               prefWidth="350" styleClass="text-field"/>
            </VBox>
            
            <!-- Confirm Password Field -->
            <VBox spacing="12" alignment="CENTER">
                <Label text="Confirm Password:" styleClass="form-label"/>
                <PasswordField fx:id="confirmPasswordField" promptText="Confirm your password" 
                               prefWidth="350" styleClass="text-field"/>
            </VBox>
            
            <!-- Sign Up Button -->
            <Button text="Create Account" onAction="#onSubmit" styleClass="btn-primary" 
                    prefWidth="350" minHeight="48"/>
            
            <!-- Back to Login Link -->
            <HBox spacing="12" alignment="CENTER">
                <Label text="Already have an account?" styleClass="muted"/>
                <Button text="Sign In" onAction="#onBackToLogin" styleClass="btn-link"/>
            </HBox>
        </VBox>

        <!-- Footer -->
        <Label text="Join thousands of players testing their art history knowledge!" 
               styleClass="muted" wrapText="true" maxWidth="500"/>
    </VBox>
</StackPane>