<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.login_page.LogInController" 
      styleClass="login-container" 
      spacing="24" alignment="CENTER">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <!-- Header Section -->
    <VBox spacing="8" alignment="CENTER">
        <Label text="🎨 Historical Art Guesser" styleClass="title"/>
        <Label text="Welcome back! Please sign in to continue" styleClass="subtitle"/>
    </VBox>

    <!-- Login Form -->
    <VBox styleClass="card" spacing="20" alignment="CENTER" prefWidth="400">
        <Label text="🔐 Sign In" styleClass="h2"/>
        
        <!-- Username Field -->
        <VBox spacing="8" alignment="CENTER">
            <Label text="Username:" styleClass="form-label"/>
            <TextField fx:id="usernameField" promptText="Enter your username" prefWidth="300" styleClass="text-field"/>
        </VBox>
        
        <!-- Password Field -->
        <VBox spacing="8" alignment="CENTER">
            <Label text="Password:" styleClass="form-label"/>
            <PasswordField fx:id="passwordField" promptText="Enter your password" prefWidth="300" styleClass="text-field"/>
        </VBox>
        
        <!-- Login Button -->
        <Button text="Sign In" onAction="#onLogin" styleClass="btn-primary" prefWidth="300"/>
        
        <!-- Sign Up Link -->
        <HBox spacing="8" alignment="CENTER">
            <Label text="Don't have an account?" styleClass="muted"/>
            <Button text="Sign Up" onAction="#onSignup" styleClass="btn-link"/>
        </HBox>
    </VBox>

    <!-- Demo Users Info -->
    <VBox styleClass="card" spacing="12" alignment="CENTER" prefWidth="400">
        <Label text="🧪 Demo Accounts" styleClass="h3"/>
        <VBox spacing="4" alignment="CENTER">
            <Label text="Username: demo | Password: demo123" styleClass="demo-account"/>
            <Label text="Username: test | Password: test123" styleClass="demo-account"/>
            <Label text="Username: admin | Password: admin123" styleClass="demo-account"/>
        </VBox>
    </VBox>

    <!-- Footer -->
    <Label text="Test your knowledge of famous artworks and their history!" styleClass="muted" wrapText="true" maxWidth="400"/>
</VBox>