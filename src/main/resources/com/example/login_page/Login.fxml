<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.login_page.LogInController"
      alignment="CENTER">

    <stylesheets><URL value="@styles.css"/></stylesheets>
    <padding><Insets top="32" right="24" bottom="32" left="24"/></padding>

    <VBox spacing="14" maxWidth="360" styleClass="card">
        <Label text="Login" styleClass="h1"/>
        <Label text="Welcome back. Please sign in." styleClass="muted"/>

        <TextField fx:id="usernameField" promptText="Username"/>
        <PasswordField fx:id="passwordField" promptText="Password"/>

        <Button text="Login" onAction="#onLogin" styleClass="btn-primary" maxWidth="Infinity"/>

        <HBox alignment="CENTER" spacing="6">
            <Label text="Don't have an account?" styleClass="muted"/>
            <Hyperlink text="Sign up" onAction="#onSignup"/>
        </HBox>
    </VBox>
</VBox>
