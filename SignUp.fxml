<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cab302_javafx.SignUpController"
            prefWidth="420" prefHeight="560" stylesheets="@style.css">
    <center>
        <VBox spacing="20" alignment="CENTER" styleClass="card" maxWidth="380">
            <Label text="Create an Account" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Label text="Join us and start your adventure." style="-fx-font-size: 16px;"/>

            <VBox spacing="8" maxWidth="320">
                <Label text="Username"/>
                <TextField fx:id="usernameField" promptText="Choose a username"/>
            </VBox>

            <VBox spacing="8" maxWidth="320">
                <Label text="Email"/>
                <TextField fx:id="emailField" promptText="you@example.com"/>
            </VBox>

            <VBox spacing="8" maxWidth="320">
                <Label text="Password"/>
                <PasswordField fx:id="passwordField" promptText="••••••••"/>
            </VBox>

            <Button text="Sign Up" onAction="#handleSignUp" prefWidth="320"/>

            <HBox alignment="CENTER" spacing="6">
                <Label text="Already have an account?"/>
                <Hyperlink text="Sign in" onAction="#goToLogin"/>
            </HBox>
        </VBox>
    </center>
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
</BorderPane>